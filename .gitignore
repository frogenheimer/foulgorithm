# Secrets
.env
.env.*
!.env.example
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/

# Data. Raw caches and snapshots are large and reproducible, so they stay out of git.
# data/reference/ IS committed: crosswalks are decisions, not derived data.
data/raw/
data/snapshots/
data/scratch/
!data/reference/
!data/reference/**
# data/state/ IS committed: it is what the scheduled jobs have already seen, not
# a cache. A job cannot commit an ignored path, so state kept under data/raw/
# was lost between every run.
!data/state/
!data/state/**

# Backtest artifacts
runs/

# Node
node_modules/
.next/
out/
.vercel/

# OS
.DS_Store
Icon?
Thumbs.db

# Ranked player sweeps and squad lists. Regenerated from the league's API on a
# 12-hour cache, ~3 minutes cold, and they are a snapshot of a live source
# rather than a settled season file like the football-data CSVs.
data/raw/pulselive/ranked_*.json
data/raw/pulselive/squads_*.json
