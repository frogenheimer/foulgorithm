# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Supabase ---
# One project. See docs/decisions/ADR-010-single-database.md
# Find these in the Supabase dashboard: Project Settings -> API (or "API Keys").
# The service key bypasses row level security. It goes here and nowhere else:
# never in the site, never in a notebook, never in a commit, never in chat.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Data sources ---
# API-Football (api-sports.io). Free tier: 100 requests/day, 10/min.
# Find it at dashboard.api-football.com, on the dashboard home or under Profile.
API_FOOTBALL_KEY=

# The Odds API (the-odds-api.com). Free tier. Optional, barely used, M7 only.
ODDS_API_KEY=

# Contact address sent in the User-Agent when scraping, so sources can reach us.
SCRAPER_CONTACT_EMAIL=

# --- Alerting (optional until M4) ---
# Telegram bot token from BotFather, and the chat id to send to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
