# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which database to use: dev or prod. Defaults to dev.
FOULGORITHM_ENV=dev

# Safety switch. Only set to 1 when deliberately writing to production from a local machine.
# GitHub Actions sets this itself. Leave unset otherwise.
# ALLOW_PROD_WRITE=

# --- Supabase: dev project ---
SUPABASE_DEV_URL=
SUPABASE_DEV_ANON_KEY=
SUPABASE_DEV_SERVICE_KEY=

# --- Supabase: prod project ---
SUPABASE_PROD_URL=
SUPABASE_PROD_ANON_KEY=
SUPABASE_PROD_SERVICE_KEY=

# --- Data sources ---
# API-Football (api-sports.io). Free tier.
API_FOOTBALL_KEY=

# The Odds API (the-odds-api.com). Free tier. Optional, only needed for M7.
ODDS_API_KEY=

# Contact address sent in the User-Agent when scraping, so sources can reach us.
SCRAPER_CONTACT_EMAIL=

# --- Alerting ---
# Telegram bot token from BotFather, and the chat id to send to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
